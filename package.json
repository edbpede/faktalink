{
  "name": "faktalink-video-viewer",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Find and play every video embedded on a faktalink.dk emne page.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "check": "bunx --bun astro check && bunx --bun svelte-check --tsconfig ./tsconfig.json",
    "crawl": "bun run scripts/crawl.ts",
    "crawl:refresh": "bun run scripts/crawl.ts --refresh",
    "test": "bun test",
    "check:bundle": "bun run scripts/check-bundle.ts",
    "test:e2e": "bunx --bun playwright test",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "format": "bunx --bun biome check --write .",
    "hooks": "prek install"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@nanostores/persistent": "1.3.5",
    "astro": "7.2.2",
    "clsx": "2.1.1",
    "nanostores": "1.5.1",
    "svelte": "5.56.9",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "9.0.1",
    "@biomejs/biome": "2.5.8",
    "@iconify-json/lucide": "1.2.123",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@unocss/astro": "66.7.5",
    "@unocss/reset": "66.7.5",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "unocss": "66.7.5",
    "unocss-preset-animations": "1.3.0",
    "unocss-preset-shadcn": "1.0.1"
  }
}
