---
import type { GetStaticPaths } from "astro";
import EmnePage from "../../../components/EmnePage.astro";
import { getEmner } from "../../../lib/collection";

/** One prerendered route per indexed emne, in the English UI. */
export const getStaticPaths = (async () => {
  const emner = await getEmner();
  return emner.map((emne) => ({
    params: { slug: emne.slug },
    props: { emneTitle: emne.title, videos: emne.videos },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const { emneTitle, videos } = Astro.props;
---

<EmnePage locale="en" slug={slug!} emneTitle={emneTitle} videos={videos} />
