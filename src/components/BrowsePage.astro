---
import EmneFilter from "../components/EmneFilter.svelte";
import { type Locale, useTranslations } from "../i18n";
import { emnePath, pastePath } from "../lib/paths";
import type { EmneEntry } from "../lib/types";
import { formatCount } from "../lib/utils";
import Layout from "../layouts/Layout.astro";

interface Props {
  locale: Locale;
  entries: EmneEntry[];
  videoCount: number;
}

const { locale, entries, videoCount } = Astro.props;
const t = useTranslations(locale);
---

<Layout
  locale={locale}
  title={`${t("browseHeading")} — ${t("siteName")}`}
  description={t("browseIntro")}
>
  <section class="max-w-2xl">
    <p class="eyebrow m-0">{t("browseEyebrow")}</p>
    <h1 class="display mt-4 text-3xl sm:text-4xl">{t("browseHeading")}</h1>
    <p class="prose-da mt-5 text-muted-foreground">{t("browseIntro")}</p>
    <p class="mt-4 font-mono text-xs text-muted-foreground">
      {formatCount(entries.length, locale)}
      {t("statEmner")} · {formatCount(videoCount, locale)}
      {t("statVideos")}
    </p>
  </section>

  <section class="mt-12">
    {
      /*
      The full index is inlined as a prop rather than fetched: it is small, and
      inlining means the list is complete in the HTML with no loading state and
      no request. The island only adds filtering on top of what is already there.
    */
    }
    <EmneFilter
      client:idle
      entries={entries}
      locale={locale}
      emneUrlTemplate={emnePath(locale, ":slug")}
      labels={{
        searchLabel: t("browseSearchLabel"),
        placeholder: t("browseSearchPlaceholder"),
        count: t("browseCount"),
        noMatches: t("browseNoMatches"),
        noMatchesHelp: t("browseNoMatchesHelp"),
        clear: t("browseClear"),
        videoOne: t("browseVideoOne"),
        videoMany: t("browseVideoMany"),
      }}
    />
  </section>

  <section class="mt-12 border-t border-border pt-6">
    <p class="m-0 text-sm text-muted-foreground">
      {t("errorUnknownSlugHelp")}
      <a
        href={pastePath(locale)}
        class="focus-ring rounded underline underline-offset-4 hover:text-foreground"
      >
        {t("navPaste")}
      </a>
    </p>
  </section>
</Layout>
