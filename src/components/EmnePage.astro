---
import VideoList from "../components/VideoList.svelte";
import { type Locale, useTranslations } from "../i18n";
import { browsePath } from "../lib/paths";
import type { VideoProps } from "../lib/types";
import { buildFaktalinkUrl } from "../lib/urls";
import Layout from "../layouts/Layout.astro";

interface Props {
  locale: Locale;
  slug: string;
  emneTitle: string;
  videos: VideoProps[];
}

const { locale, slug, emneTitle, videos } = Astro.props;
const t = useTranslations(locale);

const sourceUrl = buildFaktalinkUrl(slug);
const countLabel = videos.length === 1 ? t("emneVideoCountOne") : t("emneVideoCount");
---

<Layout
  locale={locale}
  title={`${emneTitle} — ${t("siteName")}`}
  description={`${videos.length} ${countLabel} · ${emneTitle}`}
>
  <article>
    <header class="max-w-3xl">
      <p class="eyebrow m-0">{t("emneEyebrow")}</p>
      {/* Faktalink's own title is Danish source content in both locales. */}
      <h1 class="display mt-4 text-3xl sm:text-4xl" lang={locale === "da" ? undefined : "da"}>
        {emneTitle}
      </h1>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          /*
          Astro 7 collapses JSX-style whitespace between expressions, so the
          separating space is written explicitly rather than left to the newline.
        */
        }
        <span class="font-mono text-xs tabular-nums text-muted-foreground">
          {`${videos.length} ${countLabel}`}
        </span>
        {/* Attribution: every emne page links back to its faktalink source. */}
        <a
          href={sourceUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="focus-ring inline-flex items-center gap-1.5 rounded text-xs font-medium text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:(text-foreground decoration-foreground)"
        >
          <span class="i-lucide-external-link text-xs" aria-hidden="true"></span>
          {t("emneSourceLink")}
        </a>
      </div>
    </header>

    <hr class="rule mt-8" />

    {
      videos.length === 0 ? (
        <div class="rounded-md border border-dashed border-border px-6 py-16 text-center">
          <p class="m-0 text-base font-medium text-foreground">{t("emneEmpty")}</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-muted-foreground">
            {t("emneEmptyHelp")}
          </p>
        </div>
      ) : (
        <VideoList
          client:visible
          videos={videos}
          locale={locale}
          labels={{
            play: t("videoPlay"),
            playLabel: t("videoPlayLabel"),
            fallback: t("videoFallback"),
            fallbackHint: t("videoFallbackHint"),
            posterAlt: t("videoPosterAlt"),
            idLabel: t("videoIdLabel"),
            startsAt: t("videoStartsAt"),
            untitled: t("videoUntitled"),
          }}
        />
      )
    }

    <footer class="mt-10 border-t border-border pt-6">
      <a
        href={browsePath(locale)}
        class="focus-ring inline-flex items-center gap-1.5 rounded text-xs font-medium text-muted-foreground no-underline transition-colors hover:text-foreground"
      >
        <span class="i-lucide-arrow-left text-xs" aria-hidden="true"></span>
        {t("emneBackToBrowse")}
      </a>
    </footer>
  </article>
</Layout>
