---
import EmneLookup from "../components/EmneLookup.svelte";
import { type Locale, useTranslations } from "../i18n";
import Layout from "../layouts/Layout.astro";
import { basePath } from "../lib/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout
  locale={locale}
  title={`${t("siteName")} — ${t("siteTagline")}`}
  description={t("homeIntro")}
>
  {
    /*
    One page, one job.

    The heading is set at body-copy weight and the address field below it is set
    large, bordered and shadowed. That inversion is deliberate: on a page whose
    only purpose is to take an address, the field must be what the eye lands on,
    not a headline restating the tab title. The explanation moves below the
    field, where it answers "why" for the reader who wants it without standing
    between them and the thing they came to use.
  */
  }
  <section class="max-w-2xl">
    <h1 class="m-0 text-lg font-semibold tracking-[-0.01em] text-foreground sm:text-xl">
      {t("homeHeading")}
    </h1>
  </section>

  <section class="mt-6 sm:mt-7">
    <EmneLookup
      client:load
      locale={locale}
      base={basePath()}
      labels={{
        inputLabel: t("inputLabel"),
        placeholder: t("inputPlaceholder"),
        submit: t("submit"),
        searching: t("searching"),
        help: t("inputHelp"),
        resultHeading: t("resultHeading"),
        videoOne: t("videoOne"),
        videoMany: t("videoMany"),
        sourceLink: t("sourceLink"),
        liveNotice: t("liveNotice"),
        play: t("videoPlay"),
        playLabel: t("videoPlayLabel"),
        posterAlt: t("videoPosterAlt"),
        startsAt: t("videoStartsAt"),
        untitled: t("videoUntitled"),
        clear: t("clear"),
        errors: {
          empty: t("errorEmpty"),
          "not-a-url": t("errorNotAUrl"),
          "wrong-host": t("errorWrongHost"),
          "not-an-emne": t("errorNotAnEmne"),
          "missing-slug": t("errorMissingSlug"),
          "no-videos": t("errorNoVideos"),
          "not-found": t("errorNotFound"),
          unreachable: t("errorUnreachable"),
        },
        errorHelp: {
          "not-a-url": t("errorNotAUrlHelp"),
          "wrong-host": t("errorWrongHostHelp"),
          "not-an-emne": t("errorNotAnEmneHelp"),
          "missing-slug": t("errorMissingSlugHelp"),
          "no-videos": t("errorNoVideosHelp"),
          "not-found": t("errorNotFoundHelp"),
          unreachable: t("errorUnreachableHelp"),
        },
        modal: {
          close: t("playerClose"),
          fallback: t("playerFallback"),
          blocked: t("playerBlocked"),
          blockedHelp: t("playerBlockedHelp"),
          untitled: t("videoUntitled"),
        },
      }}
    />
  </section>

  <section class="mt-12 max-w-xl border-t border-border pt-6 sm:mt-14">
    <p class="prose-da m-0 text-sm text-muted-foreground">{t("homeIntro")}</p>
  </section>
</Layout>
