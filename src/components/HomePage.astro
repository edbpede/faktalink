---
import EmneResolver from "../components/EmneResolver.svelte";
import { type Locale, useTranslations } from "../i18n";
import { browsePath, emnePath, indexJsonPath, pastePath } from "../lib/paths";
import { formatCount } from "../lib/utils";
import Layout from "../layouts/Layout.astro";

interface Props {
  locale: Locale;
  emneCount: number;
  videoCount: number;
  /** A few real entries, shown as the index's own evidence rather than filler. */
  samples: { slug: string; title: string; videoCount: number }[];
}

const { locale, emneCount, videoCount, samples } = Astro.props;
const t = useTranslations(locale);

const stats = [
  { value: formatCount(emneCount, locale), label: t("statEmner") },
  { value: formatCount(videoCount, locale), label: t("statVideos") },
];
---

<Layout
  locale={locale}
  title={`${t("siteName")} — ${t("siteTagline")}`}
  description={t("homeIntro")}
>
  <section class="max-w-3xl">
    <p class="eyebrow m-0">{t("homeEyebrow")}</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl md:text-[3.4rem]">{t("homeHeading")}</h1>
    <p class="prose-da mt-6 text-muted-foreground">{t("homeIntro")}</p>
  </section>

  <section class="mt-10 max-w-2xl">
    <EmneResolver
      client:visible
      emneUrlTemplate={emnePath(locale, ":slug")}
      indexUrl={indexJsonPath()}
      pasteUrl={pastePath(locale)}
      labels={{
        inputLabel: t("homeInputLabel"),
        placeholder: t("homeInputPlaceholder"),
        submit: t("homeSubmit"),
        help: t("homeHelp"),
        pasteLink: t("navPaste"),
        unknownSlugHelp: t("errorUnknownSlugHelp"),
        errors: {
          empty: t("errorEmpty"),
          "not-a-url": t("errorNotAUrl"),
          "wrong-host": t("errorWrongHost"),
          "not-an-emne": t("errorNotAnEmne"),
          "missing-slug": t("errorMissingSlug"),
          "unknown-slug": t("errorUnknownSlug"),
        },
      }}
    />
  </section>

  <section class="mt-14">
    <hr class="rule" />
    <dl class="m-0 grid grid-cols-2 gap-6 py-6 sm:max-w-md">
      {
        stats.map((stat) => (
          <div>
            <dt class="eyebrow m-0">{stat.label}</dt>
            <dd class="m-0 mt-1 font-mono text-2xl tabular-nums text-foreground">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
    <hr class="rule" />
  </section>

  <section class="mt-10">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="m-0 text-sm font-semibold tracking-[-0.01em]">{t("navBrowse")}</h2>
      <a
        href={browsePath(locale)}
        class="focus-ring inline-flex items-center gap-1.5 rounded text-xs font-medium text-muted-foreground no-underline transition-colors hover:text-foreground"
      >
        {t("homeBrowseLink")}
        <span class="i-lucide-arrow-right text-xs" aria-hidden="true"></span>
      </a>
    </div>

    <ul class="m-0 mt-4 list-none p-0">
      {
        samples.map((entry) => (
          <li class="border-t border-border last:border-b">
            <a
              href={emnePath(locale, entry.slug)}
              class="focus-ring flex items-baseline justify-between gap-4 py-3 no-underline transition-colors hover:bg-accent/50"
            >
              <span
                class="min-w-0 truncate text-[0.9375rem] font-medium text-foreground"
                lang={locale === "da" ? undefined : "da"}
              >
                {entry.title}
              </span>
              <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                {entry.videoCount}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
